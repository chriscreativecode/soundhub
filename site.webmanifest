{
  "name": "Sound Manager TS",
  "short_name": "SoundMgr",
  "description": "Interactive demo and documentation for Sound Manager TS audio library",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#000000",
  "icons": [
    { 
      "src": "./android-chrome-192x192.png", 
      "sizes": "192x192", 
      "type": "image/png",
      "purpose": "any maskable"
    },
    { 
      "src": "./android-chrome-512x512.png", 
      "sizes": "512x512", 
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "categories": ["development", "utilities", "audio"],
  "screenshots": [
    {
      "src": "./screenshots/demo-interface.png",
      "sizes": "1280x720",
      "type": "image/png",
      "label": "Demo Interface of Sound Manager TS"
    }
  ],
  "shortcuts": [
    {
      "name": "Open Demo",
      "url": "./",
      "description": "Launch the interactive demo"
    },
    {
      "name": "Documentation",
      "url": "../documentation/",
      "description": "View documentation"
    }
  ],
  "related_applications": [
    {
      "platform": "npm",
      "url": "https://www.npmjs.com/package/sound-manager-ts"
    }
  ],
  "prefer_related_applications": false
}