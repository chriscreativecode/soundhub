{
  "name": "Sound Manager TS",
  "short_name": "SoundMgr",
  "description": "Advanced audio management library for web applications",
  "start_url": "/sound-manager-ts/demo/",
  "display": "standalone",
  "background_color": "#2A5D91",
  "theme_color": "#2A5D91",
  "icons": [
    { "src": "/favicon-16x16.png", "sizes": "16x16", "type": "image/png" },
    { "src": "/favicon-32x32.png", "sizes": "32x32", "type": "image/png" },
    { "src": "/apple-touch-icon.png", "sizes": "180x180", "type": "image/png" },
    { "src": "/android-chrome-192x192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/android-chrome-512x512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/favicon.ico", "sizes": "48x48", "type": "image/x-icon" }
  ],
  "categories": ["development", "utilities", "audio"],
  "screenshots": [
    {
      "src": "/screenshots/demo-interface.png",
      "sizes": "1280x720",
      "type": "image/png",
      "label": "Demo Interface of Sound Manager TS"
    }
