{
  "name": "sound-manager-ts",
  "version": "5.5.8",
  "license": "MIT",
  "author": {
    "name": "Chris Schardijn",
    "email": "chriscreativecode@gmail.com",
    "url": "https://www.chriscreativecode.com"
  },
  "description": "Lightweight TypeScript soundmanager for Web Audio API. Seamless audio control in web apps and games with full type safety and modern API",
  "keywords": [
    "audio",
    "sound",
    "typescript",
    "typescript-sound-manager",
    "soundmanager",
    "sound-manager",
    "sound-manager-ts",
    "sound-engine",
    "audio-manager",
    "web-audio",
    "audio-player",
    "sound-effects",
    "audio-management",
    "browser-audio",
    "typescript-audio",
    "web-audio-api",
    "audio-library",
    "sound-library",
    "lightweight-soundmanager",
    "game-audio",
    "web-game-audio",
    "html5-audio",
    "react-audio",
    "vue-audio",
    "svelte-audio",
    "spatial-audio",
    "3d-audio",
    "hrtf"
  ],
  "type": "module",
  "main": "./dist/sound-manager-ts.umd.js",
  "module": "./dist/sound-manager-ts.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/sound-manager-ts.es.js",
      "require": "./dist/sound-manager-ts.umd.js"
    }
  },
  "files": [
    "dist/sound-manager-ts.umd.js",
    "dist/sound-manager-ts.es.js",
    "dist/types"
  ],
  "scripts": {
    "dev": "npm run dev:main",
    "dev:main": "cross-env BROWSER=chrome vite --mode demo-main",
    "dev:docs": "vite --mode documentation-dev",
    "clean": "if exist dist rmdir /s /q dist",
    "build": "npm run clean && npm run build:lib && npm run build:demo && npm run build:docs",
    "build:demo": "vite build --mode demo-main",
    "build:lib": "vite build --mode lib",
    "build:docs": "vite build --mode documentation-dev",
    "generate-docs": "node scripts/inject-readme.js",
    "debug:types": "tsc --listFiles --emitDeclarationOnly",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.10",
    "cross-env": "^7.0.3",
    "fs-extra": "^11.2.0",
    "github-markdown-css": "^5.8.1",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "marked-highlight": "^2.2.1",
    "sharp": "^0.34.5",
    "typescript": "^5.7.3",
    "vite": "^6.0.4",
    "vite-plugin-dts": "^4.5.1"
  }
}
