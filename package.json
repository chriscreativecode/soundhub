{
  "name": "sound-manager-ts",
  "version": "2.1.8",
  "author": {
    "name": "Chris Schardijn",
    "email": "chriscreativecode@gmail.com",
    "url": "https://www.chriscreativecode.com"
  },
  "description": "A lightweight, TypeScript-based Web Audio API manager for seamless sound control in web apps and games",
  "keywords": [
    "audio",
    "sound",
    "typescript",
    "sound-manager",
    "sound-engine",
    "audio-manager",
    "web-audio",
    "audio-player",
    "sound-effects",
    "audio-management",
    "browser-audio",
    "typescript-audio",
    "web-audio-api",
    "audio-library",
    "sound-library",
    "lightweight-soundmanager"
  ],
  "type": "module",
  "main": "./dist/lib/sound-manager-ts.umd.js",
  "module": "./dist/lib/sound-manager-ts.es.js",
  "exports": {
    ".": {
      "types": "./dist/lib/types/index.d.ts",
      "import": "./dist/lib/sound-manager-ts.es.js",
      "require": "./dist/lib/sound-manager-ts.umd.js",
      "default": "./dist/lib/sound-manager-ts.es.js"
    }
  },
  "files": [
    "dist/lib"
  ],
  "scripts": {
    "dev": "vite",
    "clean": "if exist dist rmdir /s /q dist",
    "build": "npm run clean && npm run build:lib && npm run build:demo",
    "build:lib": "tsc && vite build --mode lib",
    "build:demo": "vite build --mode demo && npm run copy-demo-assets && npm run rename-index",
    "rename-index": "node scripts/rename-index.js",
    "copy-demo-assets": "node scripts/copy-demo-assets.js",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "fs-extra": "^11.2.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.4",
    "vite-plugin-dts": "^4.4.0"
  }
}
