{
  "name": "sound-manager-ts",
  "version": "4.0.2",
  "author": { 
    "name": "Chris Schardijn",
    "email": "chriscreativecode@gmail.com",
    "url": "https://www.chriscreativecode.com"
  },
  "description": "A lightweight, TypeScript-based Web Audio API manager for seamless sound control in web apps and games",
  "keywords": [
    "audio",
    "sound",
    "typescript",
    "typescript-sound-manager",
    "sound-manager",
    "sound-engine",
    "audio-manager",
    "web-audio",
    "audio-player",
    "sound-effects",
    "audio-management",
    "browser-audio",
    "typescript-audio",
    "web-audio-api",
    "audio-library",
    "sound-library",
    "lightweight-soundmanager"
  ],
  "type": "module",
  "main": "./dist/sound-manager-ts.umd.js",
  "module": "./dist/sound-manager-ts.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/sound-manager-ts.es.js",
      "require": "./dist/sound-manager-ts.umd.js"
    }
  },
  "files": [
    "dist/sound-manager-ts.umd.js",
    "dist/sound-manager-ts.es.js",
    "dist/types"
  ],
  "scripts": {
    "dev": "npm run dev:main",
    "dev:main": "vite --mode demo-main",
    "dev:docs": "vite --mode documentation-dev",
    "clean": "if exist dist rmdir /s /q dist",
    "build": "npm run clean && npm run build:lib && npm run build:demo && npm run build:docs && npm run build:types",
    "build:demo": "npm run build:demo-main",
    "build:demo-main": "vite build --mode demo-main",
    "build:types": "tsc --emitDeclarationOnly",
    "build:lib": "vite build --mode lib",
    "build:docs": "vite build --mode documentation-dev",
    "generate-docs": "node scripts/inject-readme.js",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/highlight.js": "^10.1.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.10",
    "cross-env": "^7.0.3",
    "fs-extra": "^11.2.0",
    "vite": "^6.0.4",
    "vite-plugin-dts": "^4.5.0"
  },
  "dependencies": {
    "github-markdown-css": "^5.8.1",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "marked-highlight": "^2.2.1",
    "typescript": "^5.7.3"
  }
}
