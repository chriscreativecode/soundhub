{
  "name": "soundhub",
  "version": "6.5.2",
  "license": "MIT",
  "description": "One audio hub for your app: play, group, fade, sprite and position sounds through a single typed event bus, and stream long files. Duck music under a voice, vary repeated sounds, add interface sounds without files, or run Howler.js code unchanged. Web Audio API, 23 KB gzipped, zero dependencies.",
  "author": {
    "name": "Chris Schardijn",
    "email": "chriscreativecode@gmail.com",
    "url": "https://www.chriscreativecode.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chriscreativecode/soundhub.git"
  },
  "bugs": {
    "url": "https://github.com/chriscreativecode/soundhub/issues"
  },
  "homepage": "https://soundhub.chriscreativecode.com/",
  "funding": {
    "type": "paypal",
    "url": "https://www.paypal.com/donate/?hosted_button_id=M94NZXNHS8DT2"
  },
  "keywords": [
    "audio",
    "sound",
    "web-audio",
    "web-audio-api",
    "webaudio",
    "sound-manager",
    "audio-engine",
    "sound-engine",
    "audio-library",
    "audio-player",
    "howler",
    "howler-alternative",
    "howler-compatible",
    "ducking",
    "sidechain",
    "sound-variations",
    "ui-sounds",
    "html5-audio",
    "browser-audio",
    "game-audio",
    "sound-effects",
    "audio-sprites",
    "sound-sprites",
    "spatial-audio",
    "3d-audio",
    "audio-streaming",
    "podcast",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/soundhub.cjs",
  "module": "./dist/soundhub.es.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/soundhub.umd.js",
  "jsdelivr": "./dist/soundhub.umd.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/soundhub.es.js"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/soundhub.cjs"
      }
    },
    "./ui": {
      "import": {
        "types": "./dist/types/ui/index.d.ts",
        "default": "./dist/soundhub-ui.es.js"
      },
      "require": {
        "types": "./dist/types/ui/index.d.cts",
        "default": "./dist/soundhub-ui.cjs"
      }
    },
    "./howler": {
      "import": {
        "types": "./dist/types/howler/index.d.ts",
        "default": "./dist/soundhub-howler.es.js"
      },
      "require": {
        "types": "./dist/types/howler/index.d.cts",
        "default": "./dist/soundhub-howler.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "ui": [
        "./dist/types/ui/index.d.ts"
      ],
      "howler": [
        "./dist/types/howler/index.d.ts"
      ]
    }
  },
  "files": [
    "dist/soundhub.es.js",
    "dist/soundhub.cjs",
    "dist/soundhub.umd.js",
    "dist/soundhub-ui.es.js",
    "dist/soundhub-ui.cjs",
    "dist/soundhub-howler.es.js",
    "dist/soundhub-howler.cjs",
    "dist/types",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --mode examples",
    "build": "npm run typecheck && vite build --mode lib && vite build --mode extras",
    "build:examples": "vite build --mode examples",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.4",
    "vite-plugin-dts": "^4.5.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18"
  }
}
